{
  "name": "dither-ts",
  "version": "0.1.0",
  "description": "Open source dithering experiment in TypeScript",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "npm --prefix app run dev",
    "desktop": "npm --prefix app run build && npm --prefix electron run dev",
    "start": "npx --yes serve .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/test/smoke.js",
    "bench": "npm run build && node dist/test/bench.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,json,md,html}": "prettier --write",
    "*.{js,ts}": "oxlint --fix"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^22.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
